# Local development template. Copy to .env; .env is gitignored.
# Production uses production.env.example as its separate checklist/template.

DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-development-only-secret-key-never-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Inside Docker Compose, DB_HOST/REDIS_HOST are the service names below.
# For local (non-Docker) dev, use DB_HOST=127.0.0.1 REDIS_HOST=127.0.0.1
# and make sure Docker's mysql/redis containers are running (they still
# publish to localhost:3306 / localhost:6379).
DB_NAME=hfss
DB_USER=hfss
DB_PASSWORD=hfss
DB_ROOT_PASSWORD=hfss_root
DB_HOST=mysql
DB_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_CELERY_DB=0

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local HTTP must not trust proxy HTTPS headers or enable HSTS.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Authentication abuse protection. DRF rate syntax accepts values such as
# 5/minute or 100/hour. Keep DRF_NUM_PROXIES=0 unless requests pass through
# that exact number of trusted reverse proxies which sanitize X-Forwarded-For.
AUTH_LOGIN_IP_THROTTLE_RATE=30/minute
AUTH_LOGIN_USERNAME_THROTTLE_RATE=5/minute
AUTH_REFRESH_IP_THROTTLE_RATE=60/minute
DRF_NUM_PROXIES=0

# Result application is currently synchronous; keep eager mode until a tested
# Celery worker/runtime is introduced in its dedicated production phase.
CELERY_TASK_ALWAYS_EAGER=True

# Shared dev-only password for every seeded demo user (staff + invented
# admin/HM/DOS/Bursar/HR accounts). Never used outside seed_demo_data.
SEED_DEMO_PASSWORD=Demo@2025
