# NON-DEPLOYABLE checklist. Replace every placeholder. See CPANEL.md.
DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=False
DJANGO_CACHE_BACKEND=database
CELERY_TASK_ALWAYS_EAGER=True
DJANGO_SECRET_KEY=change-me-with-a-generated-unique-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=api.hopefulfuture.ac.ug
CORS_ALLOWED_ORIGINS=https://www.hopefulfuture.ac.ug
CSRF_TRUSTED_ORIGINS=https://www.hopefulfuture.ac.ug
DB_NAME=account_sms
DB_USER=account_smsapp
DB_PASSWORD=change-me-with-a-unique-database-password-of-at-least-20-characters
DB_HOST=localhost
DB_PORT=3306
# Use only after confirming Passenger provides native HTTPS and REMOTE_ADDR.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DRF_NUM_PROXIES=0
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
AUTH_LOGIN_IP_THROTTLE_RATE=30/minute
AUTH_LOGIN_USERNAME_THROTTLE_RATE=5/minute
AUTH_REFRESH_IP_THROTTLE_RATE=60/minute
DJANGO_STATIC_ROOT=/home/ACCOUNT/API_DOCUMENT_ROOT/static
DJANGO_MEDIA_ROOT=/home/ACCOUNT/private_sms_media
