# Production configuration template — never deploy these placeholder values.
# Copy the variable names into the platform's encrypted secret/config store,
# replace every `.example` hostname and every `change-me` value, then run the
# preflight commands documented in AGENT.md before starting public traffic.

DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=False

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-with-a-generated-unique-secret-of-at-least-50-characters

# Backend hostname only: no https://, port, or path. Add comma-separated names
# only when every name is intentionally routed to this backend.
DJANGO_ALLOWED_HOSTS=api.hopefulfuture.ac.ug

# Frontend origins: include https://, omit paths and trailing slashes.
CORS_ALLOWED_ORIGINS=https://www.hopefulfuture.ac.ug
CSRF_TRUSTED_ORIGINS=https://www.hopefulfuture.ac.ug

# Least-privilege MySQL application account. Generate the password separately,
# for example with: openssl rand -hex 32
DB_NAME=hopeful_future_sms
DB_USER=hopeful_future_app
DB_PASSWORD=change-me-with-a-unique-database-password-of-at-least-20-characters
DB_HOST=mysql
DB_PORT=3306

# Redis must be reachable only through a protected private network. Cache DB 1
# is separate from Celery DB 0 so cache clearing never removes queued work.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_CELERY_DB=0

# Example for exactly one trusted TLS-terminating reverse proxy (such as one
# Nginx/ingress hop) which removes incoming forwarded headers and writes its
# own X-Forwarded-Proto/X-Forwarded-For values. See AGENT.md for other layouts.
DJANGO_TRUST_PROXY_SSL_HEADER=True
DRF_NUM_PROXIES=1

# Start HSTS at one hour after HTTPS is verified. Increase to 31536000 only
# after sustained validation. Do not enable subdomains/preload until every
# subdomain is permanently HTTPS-ready.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Phase 27 authentication abuse controls.
AUTH_LOGIN_IP_THROTTLE_RATE=30/minute
AUTH_LOGIN_USERNAME_THROTTLE_RATE=5/minute
AUTH_REFRESH_IP_THROTTLE_RATE=60/minute

# Results remain synchronous until the separate worker/runtime phase.
CELERY_TASK_ALWAYS_EAGER=True

# Phase 29 Gunicorn worker count. Tune against measured memory/DB capacity.
WEB_CONCURRENCY=2

# Never provide SEED_DEMO_PASSWORD or run seed_demo_data in production.
